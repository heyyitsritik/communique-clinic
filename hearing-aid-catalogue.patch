+              <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
+                {filtered.map((product) => (
+                  <ProductCard key={product.slug} product={product} />
+                ))}
+              </div>
+            )}
+
+            {/* CTA */}
+            <div className="mt-12 bg-[#1B4D3E] rounded-2xl p-8 text-white text-center">
+              <h3 className="font-playfair text-xl font-bold mb-2">Not sure which hearing aid is right for you?</h3>
+              <p className="text-white/70 text-sm mb-5">
+                Book a free consultation with Dr. Saurabh — he'll recommend the best fit for your hearing loss, lifestyle and budget.
+              </p>
+              <a href="/#contact" className="inline-block bg-[#B8892A] text-white font-semibold px-6 py-3 rounded-full hover:bg-[#a07824] transition text-sm">
+                📅 Book Free Consultation
+              </a>
+            </div>
+          </main>
+        </div>
+      </div>
+    </div>
+  )
+}
