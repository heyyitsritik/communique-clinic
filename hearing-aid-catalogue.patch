From f597bcdc3f5493e177bd4faa1526c05adf4850f7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 12:58:07 +0000
Subject: [PATCH 2/2] Fix product pages for Next.js 16 async params; add image
 placeholder

Product detail pages now await params (required in Next 16). Cards and
detail pages show a branded "image coming soon" placeholder until the
manufacturer photos are added to public/products/.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011fGCJz22VPX1omRnq8NFk7
---
 src/app/hearing-aids/[slug]/page.tsx    | 21 ++++++-----
 src/app/hearing-aids/catalogue/page.tsx | 15 +++-----
 src/components/ProductImage.tsx         | 46 +++++++++++++++++++++++++
 3 files changed, 62 insertions(+), 20 deletions(-)
 create mode 100644 src/components/ProductImage.tsx

diff --git a/src/app/hearing-aids/[slug]/page.tsx b/src/app/hearing-aids/[slug]/page.tsx
index 856593a..5b63b6f 100644
--- a/src/app/hearing-aids/[slug]/page.tsx
+++ b/src/app/hearing-aids/[slug]/page.tsx
@@ -1,10 +1,10 @@
 import { notFound } from 'next/navigation'
-import Image from 'next/image'
 import Link from 'next/link'
 import type { Metadata } from 'next'
+import ProductImage from '@/components/ProductImage'
 import products from '@/data/products.json'
 
-type Product = typeof products[0]
+type PageProps = { params: Promise<{ slug: string }> }
 
 function formatPrice(p: number | null) {
   if (!p) return null
@@ -15,8 +15,9 @@ export async function generateStaticParams() {
   return products.map((p) => ({ slug: p.slug }))
 }
 
-export async function generateMetadata({ params }: { params: { slug: string } }): Promise<Metadata> {
-  const product = products.find((p) => p.slug === params.slug)
+export async function generateMetadata({ params }: PageProps): Promise<Metadata> {
+  const { slug } = await params
+  const product = products.find((p) => p.slug === slug)
   if (!product) return { title: 'Product Not Found' }
   return {
     title: `${product.model_name} | Communiqué Clinic Gurugram`,
@@ -24,8 +25,9 @@ export async function generateMetadata({ params }: { params: { slug: string } })
   }
 }
 
-export default function ProductPage({ params }: { params: { slug: string } }) {
-  const product = products.find((p) => p.slug === params.slug)
+export default async function ProductPage({ params }: PageProps) {
+  const { slug } = await params
+  const product = products.find((p) => p.slug === slug)
   if (!product) notFound()
 
   const related = products
@@ -50,11 +52,12 @@ export default function ProductPage({ params }: { params: { slug: string } }) {
           {/* Image Panel */}
           <div className="bg-white rounded-2xl border border-[#E8E0D5] p-8 flex flex-col items-center">
             <div className="relative w-full max-w-xs h-64 mb-6">
-              <Image
